{
  "manifest_version": 3,
  "name": "Make.com ROI Checker",
  "version": "0.1.0",
  "description": "Injects a button on Make.com scenario pages to check ROI and process data.",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.make.com/",
    "https://api.openai.com/",
    "https://*.make.com/api/v2/scenarios/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.make.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_page": "options.html"
}
