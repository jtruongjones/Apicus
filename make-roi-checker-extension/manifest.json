{
  "manifest_version": 3,
  "name": "Make.com ROI Checker",
  "version": "0.1.0",
  "description": "Injects a button on Make.com scenario pages to check ROI.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.make.com/"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.make.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
